{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/focofacofoco/roundtable/docs/doctor.schema.json",
  "title": "Roundtable doctor output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "config_path", "config_valid", "providers", "live", "capabilities", "evidence", "qualification"],
  "properties": {
    "schema_version": {"const": 1},
    "config_path": {"type": "string"},
    "config_valid": {"type": "boolean"},
    "providers": {
      "type": "array",
      "items": {"$ref": "#/$defs/providerStatus"}
    },
    "live": {"type": "object", "additionalProperties": {"enum": ["ok", "failed"]}},
    "capabilities": {"$ref": "#/$defs/capabilityCatalog"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "qualification": {"$ref": "#/$defs/qualification"}
  },
  "$defs": {
    "providerStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "installed", "eligible", "auth_method", "reason", "cli_version", "model", "research"],
      "properties": {
        "name": {"type": "string"},
        "installed": {"type": "boolean"},
        "eligible": {"type": "boolean"},
        "auth_method": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]},
        "cli_version": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "research": {"type": "boolean"}
      }
    },
    "capabilityCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude", "grok", "gemini", "minimax"],
      "properties": {
        "codex": {"$ref": "#/$defs/capability"},
        "claude": {"$ref": "#/$defs/capability"},
        "grok": {"$ref": "#/$defs/capability"},
        "gemini": {"$ref": "#/$defs/capability"},
        "minimax": {"$ref": "#/$defs/capability"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth", "model_discovery", "effort", "research"],
      "properties": {
        "auth": {"enum": ["chatgpt", "first_party", "oauth", "google_sign_in"]},
        "model_discovery": {"enum": ["official-cli", "unsupported-by-cli"]},
        "effort": {"type": "boolean"},
        "research": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "roundtable_version", "python", "platform", "update_channel", "runtime_fingerprint"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "roundtable_version": {"type": "string"},
        "python": {"type": "string"},
        "platform": {"type": "string"},
        "update_channel": {"enum": ["beta", "stable"]},
        "runtime_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "qualified", "quorum_required", "successful", "results"],
      "properties": {
        "performed": {"type": "boolean"},
        "qualified": {"type": ["boolean", "null"]},
        "quorum_required": {"const": 2},
        "successful": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "status", "model", "duration_ms"],
            "properties": {
              "provider": {"type": "string"},
              "status": {"type": "string"},
              "model": {"type": ["string", "null"]},
              "duration_ms": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        }
      }
    }
  }
}
